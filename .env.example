# Webhook URL to POST agent done/blocked events to.
WEBHOOK_URL=
# Optional. Set to 0, false, no, or off to default-disabled without unlinking the plugin.
# The toggle action writes a local state file that overrides this default.
HERDR_WEBHOOK_ENABLED=1
# Optional. Extra JSON headers to send, e.g. WEBHOOK_HEADERS_JSON={"Authorization":"Bearer xxxx"}
# WEBHOOK_HEADERS_JSON=
